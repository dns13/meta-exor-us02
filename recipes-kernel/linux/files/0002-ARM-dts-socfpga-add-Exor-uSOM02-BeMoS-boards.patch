From eade623a5385c459831ff787eb9ba44248852472 Mon Sep 17 00:00:00 2001
From: Jan Schoeppach <jan.schoeppach@metax-gmbh.de>
Date: Fri, 23 Oct 2026 11:37:05 +0200
Subject: [PATCH 2/2] ARM: dts: socfpga: add Exor uSOM02 BeMoS boards

Device trees for BeMoS on the Exor uSOM02 module (Cyclone V SoC):
- socfpga_cyclone5_bemos: analog board 2.3.7
- socfpga_cyclone5_bemos_v8: analog board v8

Ported from socfpga_cyclone5_exor.dts, socfpga_cyclone5_bemos.dts and
socfpga_bemos_v8.dts of the 4.1 BSP. The mmc aliases keep the old
numbering (mmcblk0 = eMMC, mmcblk1 = SD card).

Upstream-Status: Inappropriate [board specific, Exor uSOM02 / BeMoS]
---
 arch/arm/boot/dts/intel/socfpga/Makefile      |   2 +
 .../intel/socfpga/socfpga_cyclone5_bemos.dts  |  42 +++++
 .../socfpga/socfpga_cyclone5_bemos_v8.dts     | 122 ++++++++++++
 .../socfpga/socfpga_cyclone5_usom02.dtsi      | 178 ++++++++++++++++++
 4 files changed, 344 insertions(+)
 create mode 100644 arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos.dts
 create mode 100644 arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos_v8.dts
 create mode 100644 arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_usom02.dtsi

diff --git a/arch/arm/boot/dts/intel/socfpga/Makefile b/arch/arm/boot/dts/intel/socfpga/Makefile
index 7f69a0355ea5..7dae70e0c02e 100644
--- a/arch/arm/boot/dts/intel/socfpga/Makefile
+++ b/arch/arm/boot/dts/intel/socfpga/Makefile
@@ -8,6 +8,8 @@ dtb-$(CONFIG_ARCH_INTEL_SOCFPGA) += \
 	socfpga_arria10_socdk_sdmmc.dtb \
 	socfpga_cyclone5_chameleon96.dtb \
 	socfpga_cyclone5_mcvevk.dtb \
+	socfpga_cyclone5_bemos.dtb \
+	socfpga_cyclone5_bemos_v8.dtb \
 	socfpga_cyclone5_socdk.dtb \
 	socfpga_cyclone5_de0_nano_soc.dtb \
 	socfpga_cyclone5_de10nano.dtb \
diff --git a/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos.dts b/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos.dts
new file mode 100644
index 000000000000..48a2ca80ac9f
--- /dev/null
+++ b/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos.dts
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * BeMoS on the Exor uSOM02, analog board 2.3.7
+ * (socfpga.dtb on the boot partition)
+ */
+
+/dts-v1/;
+
+#include "socfpga_cyclone5_usom02.dtsi"
+
+/ {
+	model = "BeMoS (Exor uSOM02, analog board 2.3.7)";
+	compatible = "bstsns,bemos", "exor,usom02", "altr,socfpga-cyclone5",
+		     "altr,socfpga";
+
+	soc {
+		analogboard_0: bemos@ff240000 {
+			compatible = "bstsns,analogboard-2.3.7", "bstsns,analogboard";
+			reg = <0xff240000 0x00000400>,
+			      <0xc0020000 0x00000008>,
+			      <0xff280000 0x00000040>,
+			      <0xff240400 0x00000040>,
+			      <0xc0070000 0x00000008>,
+			      <0xc0090000 0x00000008>,
+			      <0xc00a0000 0x00000008>,
+			      <0xc00b0000 0x00000008>,
+			      <0xff221000 0x00000020>,
+			      <0xff271000 0x00000020>,
+			      <0xff291000 0x00000020>,
+			      <0xff2a1000 0x00000020>,
+			      <0xff2b1000 0x00000020>,
+			      <0xff210010 0x00000008>,
+			      <0xff240500 0x00000008>,
+			      <0xff240600 0x00000008>,
+			      <0xff201000 0x00000008>;
+			reg-names = "ab", "fifo", "temp", "i2c", "ks", "int", "rt1",
+				    "rt2", "fifo_csr", "ks_csr", "int_csr",
+				    "rt1_csr", "rt2_csr", "board_temp", "cl0",
+				    "cl1", "version";
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos_v8.dts b/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos_v8.dts
new file mode 100644
index 000000000000..3b6458eb32a1
--- /dev/null
+++ b/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_bemos_v8.dts
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * BeMoS on the Exor uSOM02, analog board v8
+ * (socfpga_bemos_v8.dtb on the boot partition)
+ */
+
+/dts-v1/;
+
+#include "socfpga_cyclone5_usom02.dtsi"
+
+/ {
+	model = "BeMoS (Exor uSOM02, analog board v8)";
+	compatible = "bstsns,bemos-v8", "exor,usom02", "altr,socfpga-cyclone5",
+		     "altr,socfpga";
+
+	bone_20: clock-20000000 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <20000000>;
+	};
+
+	bone_50: clock-50000000 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
+	soc {
+		spi_temp: spi@ff201060 {
+			compatible = "altr,spi-1.0";
+			reg = <0xff201060 0x20>;
+			interrupts = <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&bone_20>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			num-chipselect = <2>;
+
+			tm_tx: temperature-sensor@0 {
+				compatible = "max31865";
+				reg = <0>;
+				spi-max-frequency = <5000000>;
+				enable-dma = <1>;
+				#io-channel-cells = <0>;
+			};
+
+			tm_rx: temperature-sensor@1 {
+				compatible = "max31865";
+				reg = <1>;
+				spi-max-frequency = <5000000>;
+				enable-dma = <1>;
+				#io-channel-cells = <0>;
+			};
+		};
+
+		i2c_ab: i2c@ff2c0040 {
+			compatible = "altr,softip-i2c-v1.0";
+			reg = <0xff2c0040 0x40>;
+			interrupts = <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&bone_50>;
+			fifo-size = <4>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			dac_level: dac@4c {
+				compatible = "ti,dac5571";
+				reg = <0x4c>;
+				vref-supply = <&regulator_3_3v>;
+				#io-channel-cells = <0>;
+			};
+
+			eeprom@50 {
+				compatible = "atmel,24c04";
+				reg = <0x50>;
+				pagesize = <16>;
+			};
+
+			ab_ai: adc@68 {
+				compatible = "microchip,mcp3427";
+				reg = <0x68>;
+				#io-channel-cells = <1>;
+			};
+		};
+
+		i2c_external: i2c@ff2c0000 {
+			compatible = "altr,softip-i2c-v1.0";
+			reg = <0xff2c0000 0x40>;
+			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&bone_50>;
+			fifo-size = <4>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			eeprom@50 {
+				compatible = "atmel,24c04";
+				reg = <0x50>;
+				pagesize = <16>;
+			};
+		};
+
+		analogboard_0: bemos {
+			compatible = "bstsns,abv8";
+			i2c-external = <&i2c_external>;
+
+			io-channels = <&dac_level>, <&tm_tx>, <&tm_rx>,
+				      <&ab_ai 0>, <&ab_ai 1>;
+			io-channel-names = "level", "tm_tx", "tm_rx", "ai0", "ai1";
+
+			interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,	/* connected */
+				     <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,	/* ks0 */
+				     <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>,	/* fifo0 */
+				     <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>,	/* fifo1 */
+				     <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>,	/* fifo2 */
+				     <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>,	/* fifo3 */
+				     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>,	/* fifo4 */
+				     <GIC_SPI 52 IRQ_TYPE_LEVEL_HIGH>,	/* ks1 */
+				     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,	/* ae_dtc */
+				     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;	/* trigger_in */
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_usom02.dtsi b/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_usom02.dtsi
new file mode 100644
index 000000000000..1942609722ff
--- /dev/null
+++ b/arch/arm/boot/dts/intel/socfpga/socfpga_cyclone5_usom02.dtsi
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Exor uSOM02 module (Cyclone V SoC), common part for the BeMoS boards.
+ * Ported from socfpga_cyclone5_exor.dts of the Exor 4.1 kernel.
+ */
+
+#include "socfpga_cyclone5.dtsi"
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	model = "Exor uSOM02";
+	compatible = "exor,usom02", "altr,socfpga-cyclone5", "altr,socfpga";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x40000000>; /* 1GB */
+	};
+
+	aliases {
+		/* U-Boot copies ethaddr into this node */
+		ethernet0 = &gmac0;
+		/* fixed numbering as in the old BSP: mmcblk0 = eMMC, mmcblk1 = SD */
+		mmc0 = &mmc;
+		mmc1 = &ulti_sdc;
+	};
+
+	regulator_3_3v: regulator-3-3v {
+		compatible = "regulator-fixed";
+		regulator-name = "3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	soc {
+		/* SD card controller in the FPGA (lightweight HPS-to-FPGA bridge) */
+		ulti_sdc: mmc@ff230000 {
+			compatible = "exor,ulti_sdc-1.0", "sdhci-ultimmc";
+			reg = <0xff230000 0x10000>;
+			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+			bus-width = <4>;
+		};
+
+		/* PIO in the FPGA, bit 0/1: PHY reset lines (not used by Linux) */
+		agpio0: gpio@ff210010 {
+			compatible = "altr,pio-1.0";
+			reg = <0xff210010 0x10>;
+			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
+			altr,ngpio = <32>;
+			altr,interrupt-type = <IRQ_TYPE_LEVEL_HIGH>;
+			#gpio-cells = <2>;
+			gpio-controller;
+			#interrupt-cells = <2>;
+			interrupt-controller;
+		};
+
+		/* Soft UART and JTAG UART in the FPGA */
+		uart_external: serial@ff290000 {
+			compatible = "altr,uart-1.0";
+			reg = <0xff290000 0x20>;
+			interrupts = <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>;
+			current-speed = <115200>;
+			clock-frequency = <50000000>;
+		};
+
+		jtag_uart: serial@ff200008 {
+			compatible = "altr,juart-1.0";
+			reg = <0xff200008 0x8>;
+			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
+		};
+	};
+};
+
+&can0 {
+	status = "okay";
+};
+
+&can1 {
+	status = "okay";
+};
+
+/*
+ * EMAC0 is routed through the FPGA (MII). The PHY is configured by U-Boot
+ * (as with the Exor BSP), Linux uses the generic PHY driver.
+ */
+&gmac0 {
+	phy-mode = "mii";
+	phy-handle = <&phy0>;
+	max-frame-size = <3800>;
+	status = "okay";
+
+	mdio0 {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		phy0: ethernet-phy@0 {
+			reg = <0>;
+		};
+	};
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&gpio1 {
+	status = "okay";
+};
+
+&gpio2 {
+	status = "okay";
+};
+
+&i2c0 {
+	status = "okay";
+	clock-frequency = <100000>;
+	i2c-sda-falling-time-ns = <10000>;
+	i2c-scl-falling-time-ns = <10000>;
+
+	temperature-sensor@4c {
+		compatible = "ti,tmp75";
+		reg = <0x4c>;
+	};
+
+	eeprom@51 {
+		compatible = "atmel,24c04";
+		reg = <0x51>;
+		pagesize = <16>;
+	};
+
+	rtc@68 {
+		compatible = "st,m41t83";
+		reg = <0x68>;
+	};
+};
+
+/* eMMC on the module */
+&mmc {
+	vmmc-supply = <&regulator_3_3v>;
+	vqmmc-supply = <&regulator_3_3v>;
+	bus-width = <4>;
+	non-removable;
+	cap-mmc-highspeed;
+	clk-phase-sd-hs = <0>, <135>;
+	status = "okay";
+};
+
+&qspi {
+	status = "okay";
+
+	flash0: flash@0 {
+		compatible = "micron,n25q00", "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <100000000>;
+		m25p,fast-read;
+		cdns,read-delay = <4>;
+		cdns,tshsl-ns = <50>;
+		cdns,tsd2d-ns = <50>;
+		cdns,tchsh-ns = <4>;
+		cdns,tslch-ns = <4>;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
-- 
2.53.0

