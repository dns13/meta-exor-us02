+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot additions for the Exor uSOM02
+ */
+
+#include "socfpga-common-u-boot.dtsi"
+
+&watchdog0 {
+	status = "disabled";
+};
+
+&mmc {
+	bootph-all;
+};
+
+&uart0 {
+	clock-frequency = <100000000>;
+	bootph-all;
+};
+
+&porta {
+	bank-name = "porta";
+};
+
+&portb {
+	bank-name = "portb";
+};
+
+&portc {
+	bank-name = "portc";
+};
diff --git a/arch/arm/dts/socfpga_cyclone5_usom02.dts b/arch/arm/dts/socfpga_cyclone5_usom02.dts
new file mode 100644
index 00000000000..18fefb55e62
--- /dev/null
+++ b/arch/arm/dts/socfpga_cyclone5_usom02.dts
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Exor uSOM02 (Cyclone V SoC) on the BeMoS carrier board
+ */
+
+#include "socfpga_cyclone5.dtsi"
+
+/ {
+	model = "Exor uSOM02 BeMoS";
+	compatible = "exor,usom02", "altr,socfpga-cyclone5", "altr,socfpga";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@0 {
+		name = "memory";
+		device_type = "memory";
+		reg = <0x0 0x40000000>; /* 1GB */
+	};
+
+	aliases {
+		ethernet0 = &gmac0;
+		/* numbering as in the old BSP: mmc 0 = eMMC, mmc 1 = SD card */
+		mmc0 = &mmc;
+		mmc1 = &ulti_sdc;
+	};
+
+	regulator_3_3v: 3-3-v-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	soc {
+		/* SD card controller in the FPGA, behind the lightweight bridge */
+		ulti_sdc: mmc@ff230000 {
+			compatible = "exor,ulti_sdc-1.0", "sdhci-ultimmc";
+			reg = <0xff230000 0x10000>;
+			interrupts = <0 43 4>;
+			bus-width = <4>;
+		};
+	};
+};
+
+/* EMAC0 is routed through the FPGA (MII), PHY at address 0 */
+&gmac0 {
+	phy-mode = "mii";
+	status = "okay";
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&gpio1 {
+	status = "okay";
+};
+
+&gpio2 {
+	status = "okay";
+};
+
+&i2c0 {
+	status = "okay";
+	clock-frequency = <100000>;
+};
+
+/* eMMC on the module */
+&mmc {
+	vmmc-supply = <&regulator_3_3v>;
+	vqmmc-supply = <&regulator_3_3v>;
+	bus-width = <4>;
+	non-removable;
+	cap-mmc-highspeed;
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
