--- /dev/null
+++ b/include/configs/socfpga_usom02.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Exor uSOM02 (Cyclone V SoC) on the BeMoS carrier board
+ */
+#ifndef __CONFIG_SOCFPGA_USOM02_H__
+#define __CONFIG_SOCFPGA_USOM02_H__
+
+#include <asm/arch/base_addr_ac5.h>
+
+/* Memory configurations */
+#define PHYS_SDRAM_1_SIZE		0x40000000	/* 1GiB */
+
+/*
+ * Keep the relocated FDT within the kernel lowmem. The environments stored
+ * on existing devices come from the old U-Boot and have no bootm_size.
+ */
+#define CFG_SYS_BOOTMAPSZ		(64 << 20)
+
+/*
+ * Environment compatible with the Exor based U-Boot of the old BSP. The
+ * variable names are used by fw_setenv in the eMMC init scripts
+ * (mmcroot, mmcload, fdtimage, ethaddr, bootdelay).
+ *   mmc 0 / mmcblk0: eMMC (HPS SD/MMC controller)
+ *   mmc 1 / mmcblk1: SD card (ulti_sdc in the FPGA)
+ */
+#define USOM02_BOOTARGS		"console=ttyS0,115200"
+
+#define CFG_EXTRA_ENV_SETTINGS \
+	/* loadaddr=0x8000 comes from CONFIG_SYS_LOAD_ADDR */ \
+	"verify=n\0" \
+	"fdtaddr=0x00000100\0" \
+	"bootimage=zImage\0" \
+	"fdtimage=socfpga_bemos_v8.dtb\0" \
+	"mmcloadcmd=fatload\0" \
+	"mmcloadpart=1\0" \
+	"mmcroot=/dev/mmcblk1p2\0" \
+	"ramboot=setenv bootargs " USOM02_BOOTARGS ";" \
+		"bootz ${loadaddr} - ${fdtaddr}\0" \
+	"mmcload=mmc rescan;" \
+		"${mmcloadcmd} mmc 1:${mmcloadpart} ${loadaddr} ${bootimage};" \
+		"${mmcloadcmd} mmc 1:${mmcloadpart} ${fdtaddr} ${fdtimage}\0" \
+	"mmcboot=setenv bootargs " USOM02_BOOTARGS \
+		" root=${mmcroot} rw rootwait;" \
+		"bootz ${loadaddr} - ${fdtaddr}\0" \
+	"safeboot=setenv bootargs " USOM02_BOOTARGS \
+		" root=${mmcroot} rw rootwait" \
+		" modprobe.blacklist=bemos_ab;" \
+		"bootz ${loadaddr} - ${fdtaddr}\0" \
+	"repairboot=setenv bootargs " USOM02_BOOTARGS \
+		" root=${mmcroot} ro rootwait" \
+		" fsck.mode=force fsck.repair=yes" \
+		" modprobe.blacklist=bemos_ab;" \
+		"bootz ${loadaddr} - ${fdtaddr}\0" \
+	"netboot=dhcp ${bootimage} ; " \
+		"tftp ${fdtaddr} ${fdtimage} ; run ramboot\0" \
+	"fpgadata=0x2000000\0" \
+	"scriptfile=u-boot.scr\0" \
+	"callscript=if fatload mmc 1:1 $fpgadata $scriptfile;" \
+			"then source $fpgadata; " \
+		"else " \
+			"echo Optional boot script not found. " \
+			"Continuing to boot normally; " \
+		"fi;\0"
+
+/* The rest of the configuration is shared */
+#include <configs/socfpga_common.h>
+
+#endif	/* __CONFIG_SOCFPGA_USOM02_H__ */
