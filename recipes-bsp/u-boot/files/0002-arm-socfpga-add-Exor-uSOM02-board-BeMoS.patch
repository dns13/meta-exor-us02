diff --git a/board/exor/usom02/usom02.c b/board/exor/usom02/usom02.c
new file mode 100644
index 00000000000..2f36ad4672d
--- /dev/null
+++ b/board/exor/usom02/usom02.c
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Exor uSOM02 (Cyclone V SoC) on the BeMoS carrier board
+ *
+ * Only U-Boot proper is built for this board. The SPL is the Exor preloader
+ * which stays in place and loads u-boot.img from the SD card (partition type
+ * 0xA2, offset 256 KiB) or the eMMC boot0 partition.
+ */
+
+#include <dm.h>
+#include <init.h>
+#include <lmb.h>
+#include <miiphy.h>
+#include <linux/mii.h>
+#include <linux/sizes.h>
+#include <asm/arch/reset_manager.h>
+
+#define USOM02_PHY_ADDR		0
+
+/*
+ * arch_early_init_r() puts all HPS<->FPGA bridges into reset. On the uSOM02
+ * the SD card controller (ulti_sdc) and the BeMoS IP cores sit behind the
+ * bridges, so release them again before the MMC devices are probed. The FPGA
+ * is configured before the preloader runs.
+ */
+int power_init_board(void)
+{
+	socfpga_bridges_reset(0);
+
+	return 0;
+}
+
+/*
+ * PHY setup as done by the Exor U-Boot (set_phy_params). The old kernel never
+ * wrote to the PHY, so the configuration has to happen in the bootloader on
+ * every boot, independent of any network command.
+ */
+int board_late_init(void)
+{
+	struct udevice *dev;
+	struct mii_dev *bus;
+	int ret;
+
+	/*
+	 * socfpga_cyclone5.dtsi reserves the first 4 KiB (/memreserve/) for the
+	 * Linux CPU1 trampoline, so mainline U-Boot refuses to load files there.
+	 * The Exor environment, still saved on existing devices, loads the
+	 * devicetree to fdtaddr=0x100. bootz relocates the devicetree before
+	 * starting Linux, so the area is free for U-Boot itself.
+	 */
+	lmb_free(0, SZ_4K, LMB_NOOVERWRITE);
+
+	ret = uclass_get_device_by_seq(UCLASS_ETH, 0, &dev);
+	if (ret) {
+		printf("PHY: ethernet device not found (%d)\n", ret);
+		return 0;
+	}
+
+	bus = miiphy_get_dev_by_name(dev->name);
+	if (!bus) {
+		printf("PHY: MDIO bus %s not found\n", dev->name);
+		return 0;
+	}
+
+	bus->write(bus, USOM02_PHY_ADDR, MDIO_DEVAD_NONE, 0x17, 0xb302);
+	bus->write(bus, USOM02_PHY_ADDR, MDIO_DEVAD_NONE, MII_BMCR, 0x1240);
+
+	return 0;
+}
